
classDiagram
    class User {
        +int id
        +str username
        +str password
        +bool is_active
    }

    class Paciente {
        +int id
        +str nombre
        +str apellido
        +str email
        +str dni
        +str telefono
        +str domicilio
        +str cap
        +__str__()
    }

    class Medico {
        +int id
        +str nombre
        +str apellido
        +str email
        +str matricula
        +str especialidad
        +bool validado_colegio
        +__str__()
    }

    class MatriculaColegioSimulado {
        +int id
        +str matricula
        +str nombre
        +str apellido
        +str email
        +str especialidad
        +bool habilitada
        +__str__()
    }

    class Recepcionista {
        +int id
        +str nombre
        +str apellido
        +str email
        +__str__()
    }

    class Extraccionista {
        +int id
        +str nombre
        +str apellido
        +str email
        +str legajo
        +__str__()
    }

    class ResponsableAnalisis {
        +int id
        +str nombre
        +str apellido
        +str email
        +str legajo
        +str cargo
        +__str__()
    }

    class EstadoSolicitud {
        +int id
        +str nombre
        +str descripcion
        +__str__()
    }

    class Estudio {
        +int id
        +str codigo
        +str nombre
        +str descripcion
        +str metodo_tecnica
        +str unidad_medida
        +__str__()
    }

    class RangoReferencia {
        +int id
        +float valor_min
        +float valor_max
        +str genero
        +int edad_min
        +int edad_max
        +__str__()
    }

    class Receta {
        +int id
        +date fecha_emision
        +str archivo_pdf
        +__str__()
    }

    class SolicitudAnalisis {
        +int id
        +datetime fecha_hora
        +__str__()
    }

    class SolicitudEstudio {
        +int id
        +str estado
        +__str__()
    }

    class Muestra {
        +int id
        +str tipo
        +datetime fecha_hora_extraccion
        +__str__()
    }

    class Resultado {
        +int id
        +float valor_hallado
        +datetime fecha_registro
        +__str__()
    }

    class Comprobante {
        +int id
        +datetime fecha_emision
        +str cap
        +int numero_paciente
        +save()
        +__str__()
    }

    class Notificacion {
        +int id
        +str tipo
        +str estado
        +datetime fecha_envio
        +__str__()
    }

    class LlamadoExtraccion {
        +int id
        +datetime fecha_hora
        +__str__()
    }

    User "0..1" --> "0..1" Recepcionista : cuenta
    User "0..1" --> "0..1" Extraccionista : cuenta
    User "0..1" --> "0..1" ResponsableAnalisis : cuenta

    Paciente "1" --> "0..*" Receta : tiene
    Medico "1" --> "0..*" Receta : emite

    Paciente "1" --> "0..*" SolicitudAnalisis : solicita
    Receta "0..1" --> "0..*" SolicitudAnalisis : origina
    Recepcionista "1" --> "0..*" SolicitudAnalisis : registra
    EstadoSolicitud "1" --> "0..*" SolicitudAnalisis : clasifica

    SolicitudAnalisis "1" --> "0..*" SolicitudEstudio : incluye
    Estudio "1" --> "0..*" SolicitudEstudio : corresponde

    Estudio "1" --> "0..*" RangoReferencia : posee

    SolicitudAnalisis "1" --> "0..*" Muestra : tiene
    Extraccionista "1" --> "0..*" Muestra : extrae

    SolicitudEstudio "1" --> "0..1" Resultado : produce
    ResponsableAnalisis "1" --> "0..*" Resultado : registra

    SolicitudAnalisis "1" --> "0..*" Comprobante : genera
    Muestra "1" --> "0..*" Comprobante : referencia

    SolicitudAnalisis "1" --> "0..*" Notificacion : genera

    SolicitudAnalisis "1" --> "0..1" LlamadoExtraccion : recibe
    Extraccionista "1" --> "0..*" LlamadoExtraccion : realiza
